---
// Site header: brand, primary nav, theme toggle, and a mobile menu.
import { SITE, HEADER_NAV_ITEMS } from "../consts.ts";
import ThemeToggle from "./ThemeToggle.astro";

// Normalize current path (strip trailing slash) for active-link detection.
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, "") || "/";
  return h === "/" ? current === "/" : current === h || current.startsWith(h + "/");
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.title} — home`}>
      <img
        class="brand__logo brand__logo--light"
        src="/site-logos/site-logo-light.svg"
        alt={SITE.title}
        width="450"
        height="180"
      />
      <img
        class="brand__logo brand__logo--dark"
        src="/site-logos/site-logo-dark.svg"
        alt={SITE.title}
        width="450"
        height="180"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      <button
        type="button"
        class="nav__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>

      <ul class="nav__menu" id="nav-menu" role="list">
        {
          HEADER_NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["nav__link", { "is-active": isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-inline-end: auto;
  }
  .brand__logo {
    display: block;
    width: auto;
    height: 2rem;
  }
  /* Show the logo that matches the active theme. */
  .brand__logo--dark {
    display: none;
  }
  :global([data-theme="dark"]) .brand__logo--light {
    display: none;
  }
  :global([data-theme="dark"]) .brand__logo--dark {
    display: block;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    display: inline-block;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color var(--transition),
      background-color var(--transition);
  }
  .nav__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav__link.is-active {
    color: var(--accent-hover);
    background: var(--accent-soft);
  }

  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-s);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .nav__toggle svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  /* --- Mobile --- */
  @media (max-width: 60rem) {
    .nav__toggle {
      display: inline-flex;
    }
    .nav__menu {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-2xs);
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: none;
    }
    .nav__menu.is-open {
      display: flex;
    }
    .nav__link {
      padding: var(--space-xs) var(--space-s);
      border-radius: var(--radius-s);
    }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById("nav-toggle");
    var menu = document.getElementById("nav-menu");
    if (!toggle || !menu) return;
    toggle.addEventListener("click", function () {
      var open = menu.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
  })();
</script>
