---
import { SITE, NAV_ITEMS } from "../consts.ts";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">{SITE.title}</p>
      <p class="site-footer__desc">{SITE.description}</p>
      <SocialLinks variant="row" />
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul role="list">
        {NAV_ITEMS.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container site-footer__legal">
    <p class="mono">© {year} {SITE.author}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-xl) var(--space-l);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-xl);
  }
  .site-footer__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .site-footer__desc {
    color: var(--text-muted);
    max-width: 34ch;
    margin-block: var(--space-2xs) var(--space-s);
    font-size: var(--step--1);
  }
  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    gap: var(--space-m);
  }
  .site-footer__nav a {
    display: inline-block;
    padding-block: var(--space-3xs);
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--1);
  }
  .site-footer__nav a:hover {
    color: var(--accent-hover);
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.75rem;
  }
  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
