---
// Renders a <time> element with a human-readable, mono-styled date.
interface Props {
  date: Date;
}
const { date } = Astro.props;
const iso = date.toISOString();
const label = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<time class="mono" datetime={iso}>{label}</time>
