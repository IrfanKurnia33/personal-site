---
// Renders social links from src/data/socials.ts. Two variants:
//   variant="row"  → compact icon row (footer)
//   variant="list" → labelled cards (Socials page)
import { SOCIALS } from "../data/socials.ts";

interface Props {
  variant?: "row" | "list";
}
const { variant = "row" } = Astro.props;
const items = SOCIALS.filter((s) => s.show !== false);

