---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";

export const prerender = true;

export const getStaticPaths = (async () => {
  const isProd = import.meta.env.PROD;
  const projects = (await getCollection("projects")).filter(
    (p) => !isProd || !p.data.draft,
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, year, role, tech, cover, coverAlt, url, repo } =
  project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description} article={true}>
  <article class="prose-container project">
    <header>
      <a href="/projects/" class="project__back">← Back to projects</a>
      <h1>{title}</h1>
      <p class="project__desc">{description}</p>

      <dl class="project__facts">
        {year && (<div><dt>Year</dt><dd class="mono">{year}</dd></div>)}
        {role && (<div><dt>Role</dt><dd>{role}</dd></div>)}
        {
          tech?.length > 0 && (
            <div>
              <dt>Stack</dt>
              <dd>{tech.join(" · ")}</dd>
            </div>
          )
        }
      </dl>

      <div class="project__links">
        {url && (<a class="button button--primary" href={url} target="_blank" rel="noopener">Visit site</a>)}
        {repo && (<a class="button button--ghost" href={repo} target="_blank" rel="noopener">Source</a>)}
      </div>
    </header>

    {
      cover && (
        <Image
          class="project__cover"
          src={cover}
          alt={coverAlt ?? ""}
          width={1200}
          height={750}
        />
      )
    }

    <Prose>
      <Content />
    </Prose>
  </article>
</BaseLayout>

<style>
  .project__back {
    display: inline-block;
    margin-bottom: var(--space-m);
    font-size: var(--step--1);
    text-decoration: none;
  }
  .project__desc {
    margin-top: var(--space-s);
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 60ch;
  }
  .project__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-top: var(--space-l);
  }
  .project__facts dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .project__facts dd {
    margin: 0;
    font-weight: 500;
  }
  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  .project__cover {
    width: 100%;
    margin-block: var(--space-l);
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
    aspect-ratio: 1200 / 750;
    object-fit: cover;
  }
  .project :global(.prose) {
    margin-top: var(--space-l);
  }
</style>
