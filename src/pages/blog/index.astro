---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";

const isProd = import.meta.env.PROD;
const posts = (await getCollection("blog"))
  .filter((p) => !isProd || !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const PER_PAGE = 5;
const pageCount = Math.ceil(posts.length / PER_PAGE);
---

<BaseLayout
  title="Blog"
  description="Jotting down my screams, one sentence at a time."
>
  <div class="container">
    <PageHeader
      eyebrow="Blog"
      title="Erratic Thoughts and More"
      lead="Jotting down my screams, one sentence at a time."
    />

    <div class="post-search">
      <label for="post-search-input">Search posts by title</label>
      <input
        id="post-search-input"
        type="search"
        placeholder="Search by title"
        autocomplete="off"
      />
    </div>

    {
      posts.length === 0 ? (
        <p>No posts yet — check back soon.</p>
      ) : (
        <div class="post-grid" data-per-page={PER_PAGE}>
          {posts.map((post, i) => (
            <div
              class="post-item"
              data-index={i}
              data-title={post.data.title}
              hidden={i >= PER_PAGE}
            >
              <PostCard post={post} />
            </div>
          ))}
          <p class="post-search__empty" hidden>No posts match that title.</p>
        </div>
      )
    }

    {
      pageCount > 1 && (
        <nav class="pagination" aria-label="Blog pagination">
          <button class="pagination__btn" data-page-prev disabled>
            ← Prev
          </button>
          <div class="pagination__pages">
            {Array.from({ length: pageCount }, (_, i) => (
              <button
                class="pagination__num"
                data-page-num={i + 1}
                aria-current={i === 0 ? "page" : undefined}
              >
                {i + 1}
              </button>
            ))}
          </div>
          <button class="pagination__btn" data-page-next>
            Next →
          </button>
        </nav>
      )
    }
  </div>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(
    "#post-search-input",
  );
  const grid = document.querySelector<HTMLElement>(".post-grid");
  const pagination = document.querySelector<HTMLElement>(".pagination");

  if (grid) {
    const perPage = Number(grid.dataset.perPage) || 5;
    const items = Array.from(
      grid.querySelectorAll<HTMLElement>(".post-item"),
    );
    const emptyMessage = grid.querySelector<HTMLElement>(".post-search__empty");
    const prevBtn = pagination?.querySelector<HTMLButtonElement>(
      "[data-page-prev]",
    );
    const nextBtn = pagination?.querySelector<HTMLButtonElement>(
      "[data-page-next]",
    );
    const numBtns = pagination
      ? Array.from(
          pagination.querySelectorAll<HTMLButtonElement>("[data-page-num]"),
        )
      : [];

    let current = 1;
    let matchingItems = items;

    const render = () => {
      const pageCount = Math.max(1, Math.ceil(matchingItems.length / perPage));
      current = Math.min(current, pageCount);
      const start = (current - 1) * perPage;
      const end = start + perPage;
      items.forEach((item, i) => {
        const matchIndex = matchingItems.indexOf(item);
        item.hidden = matchIndex < start || matchIndex >= end;
      });
      numBtns.forEach((btn) => {
        const page = Number(btn.dataset.pageNum);
        btn.hidden = page > pageCount;
        if (page === current) {
          btn.setAttribute("aria-current", "page");
        } else {
          btn.removeAttribute("aria-current");
        }
      });
      if (prevBtn) prevBtn.disabled = current === 1;
      if (nextBtn) nextBtn.disabled = current === pageCount;
      if (pagination) pagination.hidden = matchingItems.length <= perPage;
      if (emptyMessage) emptyMessage.hidden = matchingItems.length > 0;
    };

    const goTo = (page: number) => {
      current = Math.max(page, 1);
      render();
      window.scrollTo({ top: 0, behavior: "smooth" });
    };

    searchInput?.addEventListener("input", () => {
      const query = searchInput.value.trim().toLocaleLowerCase();
      matchingItems = items.filter((item) =>
        (item.dataset.title ?? "").toLocaleLowerCase().includes(query),
      );
      current = 1;
      render();
    });
    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));
    numBtns.forEach((btn) =>
      btn.addEventListener("click", () =>
        goTo(Number(btn.dataset.pageNum)),
      ),
    );
    render();
  }
</script>

<style>
  .post-search {
    display: grid;
    gap: var(--space-2xs);
    max-width: 28rem;
    margin-bottom: var(--space-l);
  }
  .post-search label {
    font-weight: 600;
  }
  .post-search input {
    width: 100%;
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    background: var(--surface);
  }
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    /* grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); */
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
  }
  .pagination__pages {
    display: inline-flex;
    gap: var(--space-3xs);
  }
  .pagination__btn,
  .pagination__num {
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    transition: border-color var(--transition);
  }
  .pagination__num {
    min-width: 2.25rem;
  }
  .pagination__btn:hover:not(:disabled),
  .pagination__num:hover {
    border-color: var(--accent);
  }
  .pagination__num[aria-current="page"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }
  .pagination__btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
