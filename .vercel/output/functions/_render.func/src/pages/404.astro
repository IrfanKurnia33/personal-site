---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page doesn't exist.">
  <div class="prose-container notfound">
    <p class="eyebrow mono">404</p>
    <h1>This page wandered off.</h1>
    <p class="notfound__lead">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="notfound__actions">
      <a href="/" class="button button--primary">Back home</a>
      <a href="/blog/" class="button button--ghost">Read the blog</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: var(--space-2xl);
  }
  .notfound h1 {
    font-size: var(--step-4);
    margin-block: var(--space-2xs) var(--space-s);
  }
  .notfound__lead {
    color: var(--text-muted);
    font-size: var(--step-1);
  }
  .notfound__actions {
    display: flex;
    gap: var(--space-s);
    justify-content: center;
    margin-top: var(--space-l);
  }
</style>
